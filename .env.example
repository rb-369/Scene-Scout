# ==============================================================================
# SceneScout - Environment Configuration
# ==============================================================================

# 1. PARALLEL SEARCH API (Hackathon Partner Track)
# Obtain your key from: https://platform.parallel.ai
PARALLEL_API_KEY=

# 2. GOOGLE GEMINI / GOOGLE CLOUD (Hackathon Core Agent Track)
# Option A: Gemini Developer API (Recommended for fastest setup)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Option B: Google Cloud Vertex AI (Optional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model selection (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 3. MONGODB ATLAS DATABASE (Cloud Document Store & Persistence)
# Obtain your connection URI from: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=
MONGODB_DB=scenescout

# 4. VISUAL INTELLIGENCE PROVIDERS (Official Google Maps & Place Photos)
# SceneScout auto-detects whichever provider is configured (with fallback cascade):
#
# Option A: SERPER.DEV (Highest Free Limits: 2,500 Free Queries, Maps + Images)
# Obtain your key from: https://serper.dev
SERPER_API_KEY=
#
# Option B: OPENSERP (Unlimited Self-Hosted Docker or OpenSERP Cloud)
# Deploy via Docker: docker run -d -p 7000:7000 karust/openserp
# Cloud / Hosted: https://openserp.org
OPENSERP_URL=http://localhost:7000
OPENSERP_API_KEY=
#
# Option C: SERPAPI (100 Free Queries/mo)
# Obtain your key from: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Note: If no database URI is supplied, SceneScout automatically activates
# high-fidelity local persistence with pre-researched locations.



