# ==============================================================================
# SceneScout - Environment Configuration
# ==============================================================================

# 1. PARALLEL SEARCH API (Hackathon Partner Track)
# Obtain your key from: https://platform.parallel.ai
PARALLEL_API_KEY=

# 2. GOOGLE GEMINI / GOOGLE CLOUD (Hackathon Core Agent Track)
# Option A: Gemini Developer API (Recommended for fastest setup)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Option B: Google Cloud Vertex AI (Optional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model selection (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 3. MONGODB ATLAS DATABASE (Cloud Document Store & Persistence)
# Obtain your connection URI from: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=
MONGODB_DB=scenescout

# Note: If no database URI is supplied, SceneScout automatically activates
# high-fidelity local persistence with pre-researched locations.

