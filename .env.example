# ==============================================================================
# SceneScout - Environment Configuration
# ==============================================================================

# 1. PARALLEL SEARCH API (Hackathon Partner Track)
# Obtain your key from: https://platform.parallel.ai
PARALLEL_API_KEY=

# 2. GOOGLE GEMINI / GOOGLE CLOUD (Hackathon Core Agent Track)
# Option A: Gemini Developer API (Recommended for fastest setup)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Option B: Google Cloud Vertex AI (Optional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model selection (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 3. SUPABASE CLOUD DATABASE & AUTHENTICATION (PostgreSQL + Auth)
# Obtain your Project URL and Anon Key from: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Note: If no API keys are supplied, SceneScout automatically activates
# high-fidelity Demo Mode with local persistence and pre-researched locations.
